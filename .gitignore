# Generation and benchmark outputs. Anchored at the repository root: an
# unanchored `bench/` would also swallow the runner's source package
# (src/comparativa/bench/).
/out/
/bench/

# Frozen corpus snapshot (see docs/CORPUS_PIN.md). Extracted read-only from the
# granville project's git history; stays untracked, like bench/.
/corpus/

# Audio artifacts (never committed; they belong in out/ or bench/)
*.wav
*.m4a

# Python environments and caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# The signed `produciesta` binary is a coverage-instrumented build and drops an
# LLVM profile in whatever directory it is launched from; the condition-A
# wrapper runs from the repo root, so this lands here.
default.profraw

# macOS
.DS_Store
