# (src/comparativa/bench/).
/out/
/bench/

# Audio artifacts (never committed; they belong in out/ or bench/)
*.wav
*.m4a

# Python environments and caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# macOS
.DS_Store
